{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store items available for browsing and purchasing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isFlashDeal": { "type": "boolean" },
        "flashDealEndsAt": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "specs": { "type": "object" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "shippingDays": { "type": "number" }
      },
      "required": ["id", "title", "category", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "trackingNumber": { "type": "string" },
        "courier": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "createdAt": { "type": "string" },
        "timeline": { "type": "array" }
      },
      "required": ["id", "total", "status", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" },
        "image": { "type": "string" },
        "itemCount": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer profile and authentication records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "memberSince": { "type": "string" }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "products": {
      "entity": "Product",
      "description": "Global catalog of store products"
    },
    "categories": {
      "entity": "Category",
      "description": "Global product categories"
    },
    "orders": {
      "entity": "Order",
      "description": "Placed orders trackable by tracking number or order ID"
    },
    "users": {
      "entity": "UserProfile",
      "description": "Registered user accounts and shopper profiles"
    }
  }
}
